<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      One permission, for two features you have to ask for: translation via
      DeepL, and downloading a book from a website you name.

      The downloader (WebBridge) fetches only addresses you paste in, and the
      pages linked from them that you leave ticked. Nothing is fetched on its
      own, nothing but http and https is fetched at all, and the cookies a
      site sets live in memory until the app closes.

      It is inert until you enter an API key. No key means no request is ever
      made, so an install that never opens Language settings behaves exactly
      as it did before this permission existed.

      Books are still read through the Storage Access Framework, which grants
      access to the one file you picked. There is no account, no sync, no
      analytics and no advertising SDK. The only host the app ever contacts is
      DeepL's, and only with text you asked it to translate.

      The reader itself makes no network calls at all: DeepL refuses
      client-side JavaScript, so every request is made from TranslateBridge on
      the native side. tools/audit_assets.py still fails the build if anything
      in the bundled reader tries.
    -->
    <!-- Plain http as well as https: a good many novel sites have never
         moved, and the downloader is the only thing that asks. The reader
         itself loads only from the app's own https origin. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GrimoireApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Grimoire.Splash">

        <!-- singleTop, not singleTask. A singleTask activity is moved into a
             task of its own, so a file manager handing over a book launches
             it somewhere else and is left showing its own screen — which
             looks exactly like the app declining to open the file. singleTop
             keeps the handover in the caller's task and still reuses an
             instance already on top. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Open books tapped in a file manager. Only the formats the
                 reader can actually parse are claimed: offering to open a PDF
                 and then failing is worse than not appearing in the list. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/zip" />
                <!-- Kindle books without DRM, read in the page (js/mobi.js). -->
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.amazon.mobi8-ebook" />
                <!-- RAR, and comics in it, unpacked in the page (js/rar.js). -->
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/x-cbr" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-rar" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/html" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/vnd.comicbook-rar" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Exports are written to the app's own cache and handed out through
          the share sheet. A WebView has no download handling of its own, so
          without this the export buttons did nothing at all.

          Nothing outside the app is readable through it: the paths below are
          one directory inside the cache, and access is granted per file, for
          one share, by the receiving app only.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
