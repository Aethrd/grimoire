<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Grimoire" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/grimoire_parchment</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Grimoire.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/grimoire_parchment</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Grimoire</item>
    </style>
</resources>
