<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="app_webview" />
        <exclude domain="file" path="app_webview/Default/GPUCache" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
